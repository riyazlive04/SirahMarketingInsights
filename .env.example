# Public origin of this app. Used to build the Google OAuth redirect URI and the
# post-sign-in redirects, so it must match what you register with Google exactly.
APP_URL=http://localhost:3000

# Google sign-in (the landing page's "Continue with Google").
# Create an OAuth 2.0 Client ID (type: Web application) at
#   https://console.cloud.google.com/apis/credentials
# and add {APP_URL}/api/auth/google/callback as an Authorised redirect URI.
# Without these, the landing page says so and /api/dev-login still works in dev.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32-byte hex key signing the session cookie. Rotating it signs everyone out.
# Generate with: openssl rand -hex 32
# Falls back to ENCRYPTION_KEY if unset, but keep them separate — rotating
# ENCRYPTION_KEY makes every stored Meta token unrecoverable.
SESSION_SECRET=

# Meta Ads MCP host. A Streamable HTTP MCP server (JSON-RPC 2.0, POST only).
META_MCP_URL=https://mcp.facebook.com/ads

# App A user/system-user access token with ads_mcp_management + ads_read.
# Server-side only — never prefix with NEXT_PUBLIC_.
# Used by `npm run seed` (to store it encrypted) and `npm run mcp:probe`.
META_ACCESS_TOKEN=
META_APP_ID=
META_BUSINESS_ID=

# The MCP tool that supplies the reporting timeline, and its arguments.
# Meta's tool catalogue rolls out per account, so discover yours first:
#   npm run mcp:probe
# then set the tool name and args here.
META_MCP_INSIGHTS_TOOL=
META_MCP_INSIGHTS_ARGS=

# OpenAI drives the chatbot: it reads the question, picks a Meta MCP tool, calls it
# (from this server — the Meta token is never sent to OpenAI), and writes the answer.
# Without a key the chat falls back to listing the available tools.
OPENAI_API_KEY=
# Override if your key does not have the default (gpt-4o).
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TURNS=6

# PostgreSQL. Apply db/migrations/*.sql before first run.
DATABASE_URL=postgres://ayn:ayn_dev_pw@localhost:55433/meta_mcp
# Set to false only for a local server without TLS. Leave unset in production.
DATABASE_SSL=false
# Connections per process. Serverless runs many processes at once, so this multiplies:
# set it to 2 on Vercel (and point DATABASE_URL at your provider's *pooled* endpoint).
# Defaults to 10, which is right for a single long-lived server.
DATABASE_POOL_MAX=

# 32-byte AES-256-GCM key sealing every row in meta_credentials.
# Generate with: openssl rand -hex 32
# Losing this makes every stored Meta token unrecoverable; leaking it makes every
# stored token readable. Keep it in a secret manager, never in the database.
ENCRYPTION_KEY=
